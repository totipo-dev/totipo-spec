# Keep source and configuration formatting stable on every checkout platform.
* text=auto eol=lf

# Reviewed artifacts and manifests are hashed as exact bytes. Never convert them.
/vectors/** -text
/review/** -text
/requirements/*.json -text
/requirements/*.sha256 -text

# The supplied normative Markdown uses two-space hard line breaks. Preserve its
# exact bytes while allowing that Markdown syntax in Git whitespace checks.
/spec/totipo-vault-format-v1.md whitespace=-blank-at-eol
